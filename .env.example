# For local development: copy to .env and set a random invitation code (8+ characters).
INVITE_CODE=replace-with-your-own-random-code
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Production: AppHub sets DATABASE_URL and Render sets RENDER_EXTERNAL_URL.
# DATABASE_URL=postgresql://...
# SESSION_SECRET=optional-additional-random-secret
PORT=3000
